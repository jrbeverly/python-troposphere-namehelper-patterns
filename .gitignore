**/config/*.secrets.yaml
**/config/*.secrets.yml

# Claude
.claude/settings.local.json

# Branding
branding/output/

# Ignore generated icon files everywhere except branding source
*.ico
*.png

!branding/favicon/*.ico
!branding/favicon/*.png
!branding/favicon/*.svg

!app/PortalService/public/*.svg
!app/PortalService/public/*.png
!app/PortalService/public/*.ico

!idp/frontend/public/
!idp/frontend/public/*

# OpenAPI Generated Files
api/*/openapi.json

# License CLI Test Artifacts
.test-artifacts/
*.test-artifacts/

# Terraform
# Local .terraform directories
.terraform/

# Terraform lock files (regenerated on init)
.terraform.lock.hcl

# Lambda build artifacts
.build/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Exception: backend tfvars contains only non-sensitive default values
!terraform/backend/terraform.tfvars

# Local Python environments and workspace package installs
.venv/
.python_packages/

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Optional: ignore graph output files generated by `terraform graph`
# *.dot

# Optional: ignore plan files saved before destroying Terraform configuration
# Uncomment the line below if you want to ignore planout files.
# planout
tfplan

